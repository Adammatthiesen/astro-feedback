{
  "name": "astro-feedback-api",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": "22.19.0"
  },
  "scripts": {
    "astro": "astro",
    "dev": "astro dev",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build": "astro build",
    "build:remote": "astro build --remote",
    "db:push": "astro db push",
    "db:push:remote": "astro db push --remote",
    "db:verify": "astro db verify",
    "db:init-prod": "astro db execute ./build-prod.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/db": "^0.18.0",
    "@astrojs/node": "^9.4.4",
    "astro": "^5.14.1",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/node": "^22.10.2"
  }
}
